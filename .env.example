# --- Required -------------------------------------------------------------------------------
# Generate SECRET_KEY and ENCRYPTION_KEY with:  python -m scripts.generate_keys --write
SECRET_KEY=
ENCRYPTION_KEY=
GEMINI_API_KEY=your-gemini-api-key

# Email subject/body/summary and calendar notes are encrypted at rest with ENCRYPTION_KEY (back it up: without it
# stored mail cannot be read). To rotate: put the old key here, the new one in ENCRYPTION_KEY, run
# `python -m scripts.encrypt_stored_mail`, then remove the old key. ENCRYPT_EMAIL_TEXT=false switches it off.
# ENCRYPTION_KEYS_PREVIOUS=
# ENCRYPT_EMAIL_TEXT=true

# Google OAuth client used by "Connect Gmail" (Google Cloud Console -> Credentials).
# Redirect URI to register: <PUBLIC_BASE_URL>/api/accounts/google/callback
# For local dev you can instead leave these empty and keep the downloaded credentials.json in the repo root.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft app registration used by "Connect Outlook" (Azure portal -> App registrations). Optional.
# Redirect URI to register: <PUBLIC_BASE_URL>/api/accounts/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# --- Optional (defaults are for local dev with SQLite) ---------------------------------------
# PUBLIC_BASE_URL=http://localhost:8000
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/accounts/google/callback
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/prioritizer
# REDIS_URL=redis://localhost:6379/0
# SESSION_HTTPS_ONLY=true        # set behind HTTPS in production
# SYNC_INTERVAL_SECONDS=300
# LOG_LEVEL=INFO
